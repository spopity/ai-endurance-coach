ADMIN_DATABASE_URL=
DATABASE_URL=
READONLY_DATABASE_URL=            # written by scripts/setup_readonly_role.py (history analyst's SQL)
INTERVALS_ATHLETE_ID=
INTERVALS_API_KEY=
GARMIN_PERSONAL_API_KEY=          # Garmin Connect web -> Personal API Key (health data)
GEMINI_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=           # optional: `claude setup-token` - lets Claude answer chat on your subscription
OLLAMA_BASE_URL=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Dashboard login: a long random string, entered once per browser at /login
# (python3 -c "import secrets; print(secrets.token_urlsafe(18))"). Empty = no login.
DASHBOARD_TOKEN=
# Encrypts the nightly backup (scripts/backup.py). Keep a copy outside this machine:
# without it the backups can't be restored.
BACKUP_PASSPHRASE=
# Optional off-machine copy of the backups over SMB (a NAS): the files go to <NAS_SHARE>/ai-coach.
# NAS_HOST=nas.local
# NAS_SHARE=home
# NAS_USER=
# NAS_PASSWORD=

# Optional
# CLAUDE_CHAT_MODEL=opus            # model for Claude chat answers (opus, sonnet or a full model id)
# OLLAMA_MODEL=qwen3:8b             # local model for routing + injury answers (one 8B model fits the GPU)
# LIFE_AGENT_ENABLED=false        # re-enable once Google Calendar is set up
# HOME_LOCATION=Bratislava, Slovakia   # default race-weather location
# BRIEFING_TIME=07:00                       # daily Telegram briefing, Europe/Bratislava time
