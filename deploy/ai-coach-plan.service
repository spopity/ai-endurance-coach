[Unit]
Description=AI Coach v1 - adapt the training plan to the training actually done
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-coach-v1
ExecStart=/opt/ai-coach-v1/venv/bin/python /opt/ai-coach-v1/scripts/update_plan.py --notify
StandardOutput=journal
StandardError=journal
